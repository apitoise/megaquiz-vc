# Identifiants Twitch pour l'API IGDB (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Jeton TMDB (« jeton d'accès en lecture à l'API », themoviedb.org → Paramètres → API),
# pour npm run build-pools -- films series
TMDB_READ_TOKEN=

# Port du serveur proxy local (toujours lié à 127.0.0.1)
SERVER_PORT=8787
